#!/usr/bin/env bash
# bin/egloff-api — standalone CLI + interactive setup assistant for the
# app-egloff Sanctum API (/api/tasks, /api/context-entries). Requires:
# curl, jq.
#
# The URL is preset (https://app.egloff.com.mx); only a token is required.
# Credentials resolve env > persisted config file > preset default:
#   EGLOFF_API_URL    Base URL, preset to https://app.egloff.com.mx. Only
#                     override this to point at another instance for testing.
#   EGLOFF_API_TOKEN  Sanctum token from Panel -> API Token page
#   ${XDG_CONFIG_HOME:-$HOME/.config}/egloff-api/config   (mode 0600, never sourced)
#
# Usage:
#   egloff-api                              Interactive setup assistant (no args)
#   egloff-api doctor                       Read-only diagnostics
#   egloff-api update                       Update this CLI/skill in place (git);
#                                            also repairs/prunes --project
#                                            installs tracked in the manifest
#   egloff-api config show|set-url|set-token
#   egloff-api tasks:list [--search=TEXT]
#   egloff-api tasks:create --title="..." [--project_id=N] [--description=...] \
#       [--context=...] [--status=...] [--priority=...] [--due_date=YYYY-MM-DD] \
#       [--sort_order=N] [--on_radar_today=true|false]
#   egloff-api tasks:get ID
#   egloff-api tasks:update ID --title="..." ...
#   egloff-api tasks:delete ID
#   egloff-api context:list [--search=TEXT] [--type=...] [--task_id=N] [--topic_key=...]
#   egloff-api context:create --type=... --title="..." --content="..." \
#       [--task_id=N] [--topic_key=...]
#   egloff-api context:get ID
#   egloff-api context:update ID --title="..." ...
#   egloff-api context:delete ID
#   egloff-api projects:list [--search=TEXT]
#
# context:create with --topic_key upserts (200 = updated, 201 = created).
# Without --topic_key it always creates a new row.

set -euo pipefail

# EGLOFF_API_URL resolves to a preset default when unset or explicitly
# empty. EGLOFF_API_URL_ENV snapshots the raw incoming env value BEFORE the
# seam overwrites it, so read_config() can still tell "env was set" apart
# from "env was unset" after this point.
EGLOFF_API_URL_DEFAULT="https://app.egloff.com.mx"
EGLOFF_API_URL_ENV="${EGLOFF_API_URL:-}"                    # captured BEFORE the seam
EGLOFF_API_URL="${EGLOFF_API_URL:-$EGLOFF_API_URL_DEFAULT}"

# =============================================================================
# lib — generic helpers carried over verbatim from skills/egloff-api/assets/egloff-api.sh
# =============================================================================

# --key=value ... -> JSON object on stdout. "true"/"false" become JSON
# booleans and bare integers become JSON numbers (Laravel's `boolean` rule
# rejects the string "true" — it only accepts true/false/0/1/"0"/"1"), every
# other value stays a JSON string via --arg.
args_to_json() {
  local jq_args=() filter="{"
  local first=1
  for arg in "$@"; do
    [[ "$arg" != --*=* ]] && continue
    key="${arg#--}"; key="${key%%=*}"
    val="${arg#*=}"
    if [[ "$val" == "true" || "$val" == "false" || "$val" =~ ^-?[0-9]+$ ]]; then
      jq_args+=(--argjson "$key" "$val")
    else
      jq_args+=(--arg "$key" "$val")
    fi
    if [[ $first -eq 0 ]]; then filter+=","; fi
    filter+="\"$key\":\$$key"
    first=0
  done
  filter+="}"
  jq -n "${jq_args[@]}" "$filter"
}

# --key=value ... -> "key=value&key2=value2" query string (URL-encoded via jq @uri).
args_to_query() {
  local pairs=()
  for arg in "$@"; do
    [[ "$arg" != --*=* ]] && continue
    key="${arg#--}"; key="${key%%=*}"
    val="${arg#*=}"
    encoded=$(jq -rn --arg v "$val" '$v|@uri')
    pairs+=("${key}=${encoded}")
  done
  local IFS='&'
  echo "${pairs[*]}"
}

request() {
  local method="$1" path="$2" body="${3:-}"
  local url="${EGLOFF_API_URL}${path}"
  local response status

  if [[ -n "$body" ]]; then
    response=$(curl -sS -w '\n%{http_code}' -X "$method" "$url" \
      -H "Authorization: Bearer ${EGLOFF_API_TOKEN}" \
      -H "Accept: application/json" \
      -H "Content-Type: application/json" \
      -d "$body")
  else
    response=$(curl -sS -w '\n%{http_code}' -X "$method" "$url" \
      -H "Authorization: Bearer ${EGLOFF_API_TOKEN}" \
      -H "Accept: application/json")
  fi

  status="${response##*$'\n'}"
  body_out="${response%$'\n'*}"

  echo "$body_out" | jq . 2>/dev/null || echo "$body_out"

  if [[ "$status" -ge 400 ]]; then
    echo 'run `egloff-api doctor`' >&2
    exit 1
  fi
}

# =============================================================================
# config — credential resolution and persistence
# =============================================================================

# Prints the config file path (honors XDG_CONFIG_HOME).
config_path() {
  printf '%s/egloff-api/config' "${XDG_CONFIG_HOME:-$HOME/.config}"
}

# Parses the config file only, ignoring env vars entirely. Sets
# FILE_URL/FILE_TOKEN (empty if absent/unreadable).
# Never sources or evals the config file — parsed line-by-line, whitelist
# keys only, values assigned via `printf -v`, never executed.
read_config_file() {
  FILE_URL=""
  FILE_TOKEN=""
  local config_file
  config_file="$(config_path)"

  if [ -r "$config_file" ]; then
    local line key val
    while IFS= read -r line || [ -n "$line" ]; do
      case "$line" in ''|'#'*) continue ;; esac
      key="${line%%=*}"
      val="${line#*=}"
      key="$(printf '%s' "$key" | tr -d '[:space:]')"
      case "$key" in
        EGLOFF_API_URL|EGLOFF_API_TOKEN) ;;
        *) continue ;;
      esac
      case "$val" in
        \"*\") val="${val:1:${#val}-2}" ;;
        \'*\') val="${val:1:${#val}-2}" ;;
      esac
      if [ "$key" = "EGLOFF_API_URL" ]; then
        FILE_URL="$val"
      elif [ "$key" = "EGLOFF_API_TOKEN" ]; then
        FILE_TOKEN="$val"
      fi
    done < "$config_file"
  fi
}

# Resolves EGLOFF_API_URL/EGLOFF_API_TOKEN. URL precedence: env > file >
# preset default. Token precedence: env > file > none. Sets URL_SOURCE
# (default|env|file) and TOKEN_SOURCE (env|file|none) for callers to report.
read_config() {
  local had_url="${EGLOFF_API_URL_ENV:+x}" had_token="${EGLOFF_API_TOKEN:+x}"

  read_config_file

  if [ -n "$had_token" ]; then
    TOKEN_SOURCE="env"
  elif [ -n "$FILE_TOKEN" ]; then
    EGLOFF_API_TOKEN="$FILE_TOKEN"
    TOKEN_SOURCE="file"
  else
    EGLOFF_API_TOKEN=""
    TOKEN_SOURCE="none"
  fi

  if [ -n "$had_url" ]; then
    EGLOFF_API_URL="$EGLOFF_API_URL_ENV"
    URL_SOURCE="env"
  elif [ -n "$FILE_URL" ]; then
    EGLOFF_API_URL="$FILE_URL"
    URL_SOURCE="file"
  else
    EGLOFF_API_URL="$EGLOFF_API_URL_DEFAULT"
    URL_SOURCE="default"
  fi
}

# write_config URL TOKEN — atomic, no permissive-mode window: mkdir -p,
# mktemp in the same dir under a scoped umask 077, chmod 600, mv -f.
write_config() {
  local url="$1" token="$2"
  local config_file config_dir
  config_file="$(config_path)"
  config_dir="$(dirname "$config_file")"
  mkdir -p "$config_dir"
  (
    umask 077
    tmp_file="$(mktemp "${config_dir}/.egloff-api-config.XXXXXX")"
    {
      printf 'EGLOFF_API_URL=%s\n' "$url"
      printf 'EGLOFF_API_TOKEN=%s\n' "$token"
    } > "$tmp_file"
    chmod 600 "$tmp_file"
    mv -f "$tmp_file" "$config_file"
  )
}

# ••••••••<last4>, or "(none)" if empty.
mask_token() {
  local token="$1" last4
  if [ -z "$token" ]; then
    printf '(none)'
    return 0
  fi
  last4="${token: -4}"
  printf '••••••••%s' "$last4"
}

# =============================================================================
# checks — pure, read-only, status-returning; shared by assistant and doctor
# =============================================================================

check_deps() {
  MISSING_DEPS=()
  local bin
  for bin in curl jq; do
    command -v "$bin" >/dev/null 2>&1 || MISSING_DEPS+=("$bin")
  done
  [ "${#MISSING_DEPS[@]}" -eq 0 ]
}

# GET /api/tasks?per_page=1 -> PROBE_HTTP, PROBE_BODY; returns 0 on 2xx.
check_connectivity() {
  PROBE_HTTP=""
  PROBE_BODY=""
  if [ -z "${EGLOFF_API_TOKEN:-}" ]; then
    PROBE_BODY="missing API token"
    return 1
  fi

  local response
  if ! response=$(curl -sS -w '\n%{http_code}' -X GET "${EGLOFF_API_URL}/api/tasks?per_page=1" \
      -H "Authorization: Bearer ${EGLOFF_API_TOKEN}" \
      -H "Accept: application/json" 2>&1); then
    PROBE_HTTP="000"
    PROBE_BODY="$response"
    return 1
  fi

  PROBE_HTTP="${response##*$'\n'}"
  PROBE_BODY="${response%$'\n'*}"

  if [[ "$PROBE_HTTP" =~ ^[0-9]+$ ]] && [ "$PROBE_HTTP" -ge 200 ] && [ "$PROBE_HTTP" -lt 300 ]; then
    return 0
  fi
  return 1
}

# Single TTY gate for all prompts. False under bats/CI/pipes -> callers must
# never block on `read` when this is false.
is_interactive() {
  [ -t 1 ] && { [ -t 0 ] || [ -r /dev/tty ]; }
}

# tty_read VARNAME — reads one line from the controlling terminal into
# VARNAME (empty on EOF/no tty). Isolated in its own function so tests can
# override it after sourcing this file, without touching a real /dev/tty.
tty_read() {
  local __varname="$1" __val
  IFS= read -r __val < /dev/tty || __val=""
  printf -v "$__varname" '%s' "$__val"
}

# Non-interactive guard for tasks:*/context:* subcommands.
require_creds() {
  if [ -z "${EGLOFF_API_TOKEN:-}" ]; then
    echo "error: no EGLOFF_API_TOKEN configured." >&2
    echo "Run 'egloff-api' to set up, or export EGLOFF_API_TOKEN." >&2
    echo 'run `egloff-api doctor` for details' >&2
    exit 2
  fi
}

# Single provenance renderer for URL_SOURCE/TOKEN_SOURCE, shared by doctor
# and `config show`.
url_source_label() {
  case "$URL_SOURCE" in
    default) printf 'default' ;;
    env)     printf 'env EGLOFF_API_URL' ;;
    file)    printf '%s' "$(config_path)" ;;
  esac
}

token_source_label() {
  case "$TOKEN_SOURCE" in
    env)  printf 'env EGLOFF_API_TOKEN' ;;
    file) printf '%s' "$(config_path)" ;;
    none) printf 'not set' ;;
  esac
}

# =============================================================================
# doctor — pure renderer over check_deps/check_connectivity/read_config
# =============================================================================

cmd_doctor() {
  local exit_code=0

  echo "egloff-api doctor"
  echo "-----------------"

  if check_deps; then
    echo "[ok]   dependencies: curl, jq"
  else
    echo "[fail] missing dependencies: ${MISSING_DEPS[*]}"
    exit_code=1
  fi

  read_config
  echo "[ok]   url: ${EGLOFF_API_URL} (source: $(url_source_label))"

  if [ "$TOKEN_SOURCE" != "none" ]; then
    echo "[ok]   token: loaded (source: $(token_source_label))"
  else
    echo "[fail] token: not set — export EGLOFF_API_TOKEN or run 'egloff-api' to set up"
    exit_code=1
  fi

  if [ "$TOKEN_SOURCE" != "none" ]; then
    if check_connectivity; then
      echo "[ok]   connectivity: reached ${EGLOFF_API_URL} (HTTP ${PROBE_HTTP})"
    else
      echo "[fail] connectivity: ${PROBE_BODY:-could not reach ${EGLOFF_API_URL:-<unset>}} (HTTP ${PROBE_HTTP:-000})"
      exit_code=1
    fi
  else
    echo "[skip] connectivity: no token to test"
  fi

  local upd_mode
  if upd_mode="$(_upd_detect_mode 2>/dev/null)"; then
    echo "[info] install mode: ${upd_mode} — run 'egloff-api update' to refresh"
  else
    echo "[info] install mode: unknown — run 'egloff-api update' for details"
  fi

  return $exit_code
}

# =============================================================================
# config subcommand — show|set-url|set-token
# =============================================================================

cmd_config() {
  local sub="${1:-}"
  shift || true
  case "$sub" in
    show)
      read_config
      echo "URL:    ${EGLOFF_API_URL} (source: $(url_source_label))"
      echo "Token:  $(mask_token "${EGLOFF_API_TOKEN:-}") (source: $(token_source_label))"
      ;;
    set-url)
      local new_url="${1:?usage: egloff-api config set-url URL}"
      # Preserve the token already on disk, never an env-only override —
      # env vars are a per-session override and must never get written back.
      read_config_file
      write_config "$new_url" "$FILE_TOKEN"
      echo "Saved URL to $(config_path)"
      ;;
    set-token)
      local new_token="${1:?usage: egloff-api config set-token TOKEN}"
      read_config_file
      write_config "$FILE_URL" "$new_token"
      echo "Saved token to $(config_path)"
      ;;
    *)
      echo "usage: egloff-api config <show|set-url|set-token>" >&2
      exit 1
      ;;
  esac
}

# =============================================================================
# update — self-update: refresh this CLI/skill, in bootstrap or local mode.
# install.sh is never sourced (it runs its install flow at top level) — it's
# always invoked as a subprocess. Helper prefix `_upd_*` marks these
# update-only internals.
# =============================================================================

_upd_curl_hint() {
  echo "  curl -fsSL https://raw.githubusercontent.com/AlejandroBecJim/appegloffskill/main/install.sh | bash" >&2
}

# Prints the canonical path of the running CLI script on stdout, following
# symlinks one hop at a time (portable: works with both BSD/macOS `readlink`,
# which has no -f, and GNU/Linux `readlink -f`). Capped at 40 hops as a
# cycle guard.
_upd_resolve_self() {
  local p="${BASH_SOURCE[0]}" d n=0
  [[ "$p" != /* ]] && p="$PWD/$p"
  while [ -L "$p" ]; do
    n=$((n + 1))
    [ "$n" -gt 40 ] && return 1
    d="$(cd -P "$(dirname "$p")" && pwd)"
    p="$(readlink "$p")"
    [[ "$p" != /* ]] && p="$d/$p"
  done
  printf '%s/%s' "$(cd -P "$(dirname "$p")" && pwd)" "$(basename "$p")"
}

# Prints "bootstrap" or "local" on stdout; returns 1 (prints nothing) when
# the install mode cannot be determined.
_upd_detect_mode() {
  local self self_root install_root
  self="$(_upd_resolve_self)" || return 1
  self_root="$(cd -P "$(dirname "$(dirname "$self")")" && pwd)"

  install_root="${EGLOFF_INSTALL_ROOT:-$HOME/.local/share/egloff-api-skill}"
  if [ -d "$install_root" ]; then
    install_root="$(cd -P "$install_root" && pwd)"
  fi

  if [ "$self_root" = "$install_root" ]; then
    printf 'bootstrap'
    return 0
  fi

  if [ -f "${self_root}/install.sh" ] && [ -d "${self_root}/.git" ]; then
    printf 'local'
    return 0
  fi

  return 1
}

# Prints the path to the projects manifest (same EGLOFF_STATE_ROOT seam as
# install.sh's record_project_install()).
_upd_state_manifest_path() {
  local state_root="${EGLOFF_STATE_ROOT:-${EGLOFF_INSTALL_ROOT:-$HOME/.local/share/egloff-api-skill}-state}"
  printf '%s/projects.json' "$state_root"
}

# _upd_write_manifest MANIFEST_FILE JSON — atomic write, mirrors
# write_config()/install.sh's record_project_install(): mktemp in the same
# dir under a scoped umask 077, chmod 600, mv -f. Duplicated (not shared)
# per design: install.sh must remain a single self-contained file runnable
# via curl | bash.
_upd_write_manifest() {
  local manifest_file="$1" json="$2"
  local dir tmp_file
  dir="$(dirname "$manifest_file")"
  mkdir -p "$dir"
  (
    umask 077
    tmp_file="$(mktemp "${dir}/.projects.json.XXXXXX")"
    printf '%s' "$json" > "$tmp_file"
    chmod 600 "$tmp_file"
    mv -f "$tmp_file" "$manifest_file"
  )
}

# _upd_reconcile_projects ROOT — reads the projects manifest and, for each
# entry: prunes it (and reports) if its path no longer exists, repairs it
# (re-invokes `bash ROOT/install.sh --project PATH [--copy]`) if its skill
# link is broken or absent, or counts it as healthy otherwise. Prints one
# summary line, omitted when the manifest is absent. Never aborts update:
# an absent manifest is silently "nothing to reconcile"; a corrupt one
# prints a warning and skips reconciliation.
_upd_reconcile_projects() {
  local root="$1"
  local manifest_file
  manifest_file="$(_upd_state_manifest_path)"

  [ -f "$manifest_file" ] || return 0

  if ! jq -e . "$manifest_file" >/dev/null 2>&1; then
    echo "warning: project manifest at ${manifest_file} is unreadable — skipping project reconciliation" >&2
    return 0
  fi

  local ok=0 repaired=0 pruned=0
  local pruned_paths=()
  local path mode link install_args repair_out repair_status

  while IFS= read -r -d '' path && IFS= read -r -d '' mode; do
    if [ ! -e "$path" ]; then
      pruned=$((pruned + 1))
      pruned_paths+=("$path")
      echo "Pruned missing project install: ${path}"
      continue
    fi

    link="${path}/.claude/skills/egloff-api"
    if { [ -L "$link" ] && [ ! -e "$link" ]; } || { [ ! -e "$link" ] && [ ! -L "$link" ]; }; then
      install_args=(--project "$path")
      [ "$mode" = "copy" ] && install_args+=(--copy)
      if repair_out="$(bash "${root}/install.sh" "${install_args[@]}" 2>&1)"; then
        repaired=$((repaired + 1))
      else
        repair_status=$?
        echo "warning: failed to repair project install at ${path} (exit ${repair_status})" >&2
        printf '%s\n' "$repair_out" >&2
      fi
    else
      ok=$((ok + 1))
    fi
  done < <(jq -j '.projects[]? | (.path, .mode) | . + "\u0000"' "$manifest_file" 2>/dev/null)

  if [ "$pruned" -gt 0 ]; then
    local jq_args=() filter='.version=1 | .projects //= []'
    local i=0 p
    for p in "${pruned_paths[@]}"; do
      jq_args+=(--arg "pp${i}" "$p")
      filter+=" | .projects |= map(select(.path != \$pp${i}))"
      i=$((i + 1))
    done
    local new_json
    new_json="$(jq "${jq_args[@]}" "$filter" "$manifest_file")"
    _upd_write_manifest "$manifest_file" "$new_json"
  fi

  echo "Project installs: ${ok} ok, ${repaired} repaired, ${pruned} pruned"
}

# _upd_post_update_hook ROOT — runs after a successful update in both
# bootstrap and local mode: repairs the managed global symlinks if broken,
# then reconciles per-project installs from the manifest.
_upd_post_update_hook() {
  local root="$1"
  _upd_relink_if_needed "$root"
  _upd_reconcile_projects "$root"
}

_upd_require_git() {
  if ! command -v git >/dev/null 2>&1; then
    echo "error: git is required for 'egloff-api update' but was not found on PATH — install git, or use the curl fallback below" >&2
    _upd_curl_hint
    return 1
  fi
}

# Re-runs install.sh (only) when the managed global symlinks look broken
# (a symlink that exists but no longer resolves). Never unconditional — a
# --project-only install intentionally has no global targets and must not
# be silently converted into a global one.
_upd_relink_if_needed() {
  local root="$1"
  local bin_dir="${EGLOFF_BIN_DIR:-$HOME/.local/bin}"
  local cli_target="${bin_dir}/egloff-api"
  local skill_target="${HOME}/.claude/skills/egloff-api"

  if { [ -L "$cli_target" ] && [ ! -e "$cli_target" ]; } || { [ -L "$skill_target" ] && [ ! -e "$skill_target" ]; }; then
    bash "${root}/install.sh"
  fi
}

# Bootstrap-mode update: reuses install.sh's own fetch+reset logic against
# the CLI-owned clone at EGLOFF_INSTALL_ROOT. install.sh is piped through
# stdin from a NEUTRAL cwd (never run directly from inside SELF_ROOT) —
# install.sh's own detect_mode() checks for a sibling skills/egloff-api/
# directory, which is true inside EGLOFF_INSTALL_ROOT, and would misclassify
# this as local mode (skipping the fetch+reset entirely). Piping via stdin
# from elsewhere reproduces exact `curl | bash` semantics.
_upd_update_bootstrap() {
  local root="$1" before after tmpdir status_code=0

  before="$(git -C "$root" rev-parse --short HEAD 2>/dev/null || echo unknown)"

  tmpdir="$(mktemp -d "${TMPDIR:-/tmp}/egloff-api-update.XXXXXX")"
  ( cd "$tmpdir" && bash -s -- ) < "${root}/install.sh" || status_code=$?
  rm -rf "$tmpdir"

  if [ "$status_code" -ne 0 ]; then
    echo "error: update failed (install.sh exited ${status_code})" >&2
    _upd_curl_hint
    return 1
  fi

  after="$(git -C "$root" rev-parse --short HEAD 2>/dev/null || echo unknown)"
  if [ "$before" = "$after" ]; then
    echo "Already up to date (${after})"
  else
    echo "Updated ${before} -> ${after}"
  fi

  # install.sh is invoked directly from $root (not piped) here so its own
  # detect_mode() sees the sibling skills/egloff-api/ directory and returns
  # "local", reusing the already-updated clone instead of re-fetching.
  _upd_post_update_hook "$root"
}

# Local-mode update: git fetch + git merge --ff-only @{u} ONLY — never `git
# pull`, `reset --hard`, or any force/rebase. Every precondition below
# aborts (exit 1, zero mutation) before any git command that could touch
# history.
_upd_update_local() {
  local root="$1" branch upstream local_sha upstream_sha base_sha before after
  local status_out fetch_err merge_err

  status_out="$(git -C "$root" status --porcelain 2>&1)"
  if [ -n "$status_out" ]; then
    echo "error: local checkout ${root} has uncommitted changes — commit or stash them, then re-run 'egloff-api update'" >&2
    return 1
  fi

  if ! branch="$(git -C "$root" symbolic-ref -q --short HEAD)"; then
    echo "error: ${root} has a detached HEAD — 'git -C ${root} checkout <branch>', then re-run 'egloff-api update'" >&2
    return 1
  fi

  if ! upstream="$(git -C "$root" rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null)"; then
    echo "error: branch ${branch} in ${root} has no upstream — 'git -C ${root} branch --set-upstream-to=origin/${branch}', then re-run 'egloff-api update'" >&2
    return 1
  fi

  if ! fetch_err="$(git -C "$root" fetch 2>&1)"; then
    echo "error: could not reach the remote — check your connection" >&2
    echo "$fetch_err" >&2
    return 1
  fi

  local_sha="$(git -C "$root" rev-parse '@')"
  upstream_sha="$(git -C "$root" rev-parse '@{u}')"
  base_sha="$(git -C "$root" merge-base '@' '@{u}')"
  before="$(git -C "$root" rev-parse --short HEAD)"

  if [ "$local_sha" = "$upstream_sha" ]; then
    echo "Already up to date (${before})"
    return 0
  fi

  if [ "$upstream_sha" = "$base_sha" ]; then
    echo "Local checkout is ahead of upstream; nothing to pull"
    return 0
  fi

  if [ "$local_sha" != "$base_sha" ]; then
    echo "error: ${branch} in ${root} has diverged from ${upstream} — resolve it manually (rebase/merge), then re-run 'egloff-api update'" >&2
    return 1
  fi

  if ! merge_err="$(git -C "$root" merge --ff-only '@{u}' 2>&1)"; then
    echo "error: ${merge_err}" >&2
    echo "checkout: ${root}" >&2
    return 1
  fi

  after="$(git -C "$root" rev-parse --short HEAD)"
  _upd_post_update_hook "$root"
  echo "Updated ${before} -> ${after}"
}

cmd_update() {
  _upd_require_git || return 1

  local self self_root mode
  self="$(_upd_resolve_self)" || {
    echo "error: cannot determine how egloff-api was installed (could not resolve its own path)" >&2
    _upd_curl_hint
    return 1
  }
  self_root="$(cd -P "$(dirname "$(dirname "$self")")" && pwd)"

  mode="$(_upd_detect_mode)" || {
    echo "error: cannot determine how egloff-api was installed (resolved to ${self_root})" >&2
    _upd_curl_hint
    return 1
  }

  if [ "$mode" = "bootstrap" ]; then
    _upd_update_bootstrap "$self_root"
  else
    _upd_update_local "$self_root"
  fi
}

# =============================================================================
# assistant — no-args interactive setup, gated by is_interactive()
# =============================================================================

prompt_and_persist() {
  local token persist_url
  echo "Using API URL: ${EGLOFF_API_URL} (source: $(url_source_label))"
  echo "Override it later with 'egloff-api config set-url URL'."
  printf 'Enter EGLOFF_API_TOKEN: '
  tty_read token

  # Persist the file's existing URL if present, else the preset default —
  # NEVER a resolved env-only override. Mirrors the same env-must-never-leak
  # protection already applied by `config set-url`/`set-token`.
  read_config_file
  persist_url="${FILE_URL:-$EGLOFF_API_URL_DEFAULT}"
  write_config "$persist_url" "$token"

  EGLOFF_API_TOKEN="$token"
  TOKEN_SOURCE="file"
  if check_connectivity; then
    echo "Connectivity verified (HTTP ${PROBE_HTTP})."
  else
    echo "Warning: could not verify connectivity: ${PROBE_BODY:-unreachable}"
  fi
}

offer_skill_install() {
  echo
  echo "Install the egloff-api Claude Code skill?"
  echo "  [g]lobal   ~/.claude/skills/egloff-api"
  echo "  [p]roject  ./.claude/skills/egloff-api"
  echo "  [s]kip"
  printf 'Choice [g/p/s]: '
  local choice
  tty_read choice
  case "$choice" in
    g|G) echo "Run: install.sh" ;;
    p|P) echo "Run: install.sh --project ." ;;
    *)   echo "Skipped." ;;
  esac
}

cmd_assistant() {
  if ! is_interactive; then
    read_config
    if [ "$TOKEN_SOURCE" = "none" ]; then
      echo "error: no EGLOFF_API_TOKEN found and not running in an interactive terminal." >&2
      echo "Set EGLOFF_API_TOKEN, or run 'egloff-api' interactively to set up." >&2
      exit 2
    fi
    if check_connectivity; then
      echo "config OK"
      exit 0
    else
      echo "error: stored configuration failed connectivity check: ${PROBE_BODY:-unreachable}" >&2
      echo 'run `egloff-api doctor` for details' >&2
      exit 1
    fi
  fi

  if ! check_deps; then
    echo "Missing required dependencies: ${MISSING_DEPS[*]}"
    echo "Install them and re-run 'egloff-api'."
    exit 1
  fi

  read_config

  if [ "$TOKEN_SOURCE" = "none" ]; then
    prompt_and_persist
  else
    if check_connectivity; then
      echo "config OK"
    else
      echo "Stored configuration failed: ${PROBE_BODY:-connectivity check failed}"
      printf 'Re-enter token now? [y/N] '
      local answer
      tty_read answer
      case "$answer" in
        y|Y|yes|Yes) prompt_and_persist ;;
        *)
          echo "Skipping. Run 'egloff-api config set-token' to fix manually (or 'config set-url' to point at another instance)."
          exit 1
          ;;
      esac
    fi
  fi

  offer_skill_install
}

# =============================================================================
# dispatch
# =============================================================================

main() {
  local cmd="${1:-}"
  shift || true

  case "$cmd" in
    "")
      cmd_assistant
      ;;
    doctor)
      cmd_doctor
      ;;
    update)
      cmd_update
      ;;
    config)
      cmd_config "$@"
      ;;
    tasks:list)
      read_config
      require_creds
      qs=$(args_to_query "$@")
      request GET "/api/tasks${qs:+?$qs}"
      ;;
    tasks:create)
      read_config
      require_creds
      request POST "/api/tasks" "$(args_to_json "$@")"
      ;;
    tasks:get)
      read_config
      require_creds
      request GET "/api/tasks/${1:?task id required}"
      ;;
    tasks:update)
      read_config
      require_creds
      local id="${1:?task id required}"; shift
      request PUT "/api/tasks/${id}" "$(args_to_json "$@")"
      ;;
    tasks:delete)
      read_config
      require_creds
      request DELETE "/api/tasks/${1:?task id required}"
      ;;
    context:list)
      read_config
      require_creds
      qs=$(args_to_query "$@")
      request GET "/api/context-entries${qs:+?$qs}"
      ;;
    context:create)
      read_config
      require_creds
      request POST "/api/context-entries" "$(args_to_json "$@")"
      ;;
    context:get)
      read_config
      require_creds
      request GET "/api/context-entries/${1:?context entry id required}"
      ;;
    context:update)
      read_config
      require_creds
      local id="${1:?context entry id required}"; shift
      request PUT "/api/context-entries/${id}" "$(args_to_json "$@")"
      ;;
    context:delete)
      read_config
      require_creds
      request DELETE "/api/context-entries/${1:?context entry id required}"
      ;;
    projects:list)
      read_config
      require_creds
      qs=$(args_to_query "$@")
      request GET "/api/projects${qs:+?$qs}"
      ;;
    *)
      echo "usage: egloff-api [tasks:list|tasks:create|tasks:get|tasks:update|tasks:delete|context:list|context:create|context:get|context:update|context:delete|projects:list|config|doctor|update] [--key=value ...]" >&2
      exit 1
      ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
